# ==============================================================================
# OSS Analyser Configuration (Supabase + Upstash + Gemini)
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Supabase Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Find in Supabase Dashboard -> Project Settings -> Database -> Connection String
# Transaction Pooler (recommended):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. Supabase Authentication
# ------------------------------------------------------------------------------
# Find in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_AUTH=false

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Serverless BullMQ Ingestion Queue)
# ------------------------------------------------------------------------------
# Find in Upstash Console -> Redis Database -> Connect -> "ioredis" or "Node"
UPSTASH_REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# Local Redis fallback (if UPSTASH_REDIS_URL is omitted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Hierarchical Codebase Summarization & Embeddings)
# ------------------------------------------------------------------------------
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. Deployment Mode (Hosted Demo vs. Local PC)
# ------------------------------------------------------------------------------
# Set to 'false' for local PC / Docker runs (open ingestion, no restrictions)
# Set to 'true' for hosted demo deployment (public browsing open, ingestion locked to admin key)
IS_HOSTED_DEMO=false
ADMIN_INGEST_KEY=your_secret_admin_key_here

